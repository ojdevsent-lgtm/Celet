rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function sameBusiness(businessId) {
      return signedIn() && request.auth.token.businessId == businessId;
    }

    match /businesses/{businessId} {
      allow read: if sameBusiness(businessId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if sameBusiness(businessId);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /{collection}/{document} {
        allow read, write: if sameBusiness(businessId);
      }
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
